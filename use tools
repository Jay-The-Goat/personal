local rateVal = 40
local stepFrame = Instance.new("Frame", card)
stepFrame.Size = UDim2.new(1, -16, 0, 18)
stepFrame.Position = UDim2.fromOffset(8, 50)
stepFrame.BackgroundColor3 = Color3.fromRGB(26, 26, 33)
