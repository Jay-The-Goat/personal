local scale = Instance.new("UIScale", gui)
local function updateScale()
	local cam = Workspace.CurrentCamera
	if cam then scale.Scale = math.clamp(cam.ViewportSize.Y / 430, 0.68, 1.05) end
end
updateScale()
if Workspace.CurrentCamera then Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale) end

