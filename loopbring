local function updateDropdown()
	for _, child in ipairs(DropdownList:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local isSelected = LoopBrings[player.UserId] == true
			local itemBtn = Instance.new("TextButton")
			itemBtn.Name = player.Name
			itemBtn.Size = UDim2.new(1, 0, 0, 26)
			itemBtn.BackgroundColor3 = isSelected and THEME.ActiveButtonBg or THEME.CardBg
			itemBtn.Font = Enum.Font.GothamBold
			itemBtn.TextSize = 10
			itemBtn.TextColor3 = isSelected and THEME.AccentLight or THEME.TextMuted
			itemBtn.Text = (isSelected and "★ " or "") .. player.DisplayName .. " (@" .. player.Name .. ")"
			itemBtn.AutoButtonColor = false
			itemBtn.Parent = DropdownList

			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(0, 5)
			c.Parent = itemBtn

			local s = Instance.new("UIStroke")
			s.Thickness = 1
			s.Color = isSelected and THEME.AccentPurple or THEME.BorderDark
			s.Parent = itemBtn

			itemBtn.MouseButton1Click:Connect(function()
				if LoopBrings[player.UserId] then
					LoopBrings[player.UserId] = nil
					-- Restore humanoid state if freed
					pcall(function()
						if player.Character then
							local hum = player.Character:FindFirstChildOfClass("Humanoid")
							if hum then
								hum.PlatformStand = false
							end
						end
					end)
				else
					LoopBrings[player.UserId] = true
				end
				updateDropdown()
			end)
		end
	end
end

