-- ============================================================================
-- HIGH-PERFORMANCE PRE-SIMULATION TELEPORTATION ENGINE
-- ============================================================================
local zeroVelocity = Vector3.zero

RunService.PreSimulation:Connect(function()
	if not Active then return end

	local myChar = LocalPlayer.Character
	if not myChar then return end

	local myHRP = myChar:FindFirstChild("HumanoidRootPart")
	if not (myHRP and myHRP:IsA("BasePart")) then return end

	local bringCFrame = myHRP.CFrame * CFrame.new(targetOffset, 0, -targetDistance)

	for userId in pairs(LoopBrings) do
		local player = Players:GetPlayerByUserId(userId)
		if player and player ~= LocalPlayer then
			local pChar = player.Character
			if pChar then
				local pHRP = pChar:FindFirstChild("HumanoidRootPart")
				local pHum = pChar:FindFirstChildOfClass("Humanoid")
				if pHRP and pHRP:IsA("BasePart") and pHum and pHum.Health > 0 then
					pHRP.CFrame = bringCFrame
					pHRP.AssemblyLinearVelocity = zeroVelocity
					pHRP.AssemblyAngularVelocity = zeroVelocity
					if not pHum.PlatformStand then
						pHum.PlatformStand = true
					end
				end
			end
		end
	end
end)

Players.PlayerRemoving:Connect(function(player)
	LoopBrings[player.UserId] = nil
	if DropdownList.Visible then
		updateDropdown()
	end
end)

Players.PlayerAdded:Connect(function()
