local selected = {}
local rows = {}

local function refreshList()
	for _, child in ipairs(listFrame:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	table.clear(rows)

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local row = Instance.new("TextButton", listFrame)
			row.Size = UDim2.new(1, -8, 0, 18)
			row.BackgroundColor3 = selected[plr.UserId] and Color3.fromRGB(18, 48, 34) or Color3.fromRGB(28, 28, 36)
			row.Text = plr.Name
			row.Font = Enum.Font.GothamBold
			row.TextSize = 9
			row.TextColor3 = selected[plr.UserId] and Color3.fromRGB(46, 213, 115) or Color3.fromRGB(220, 220, 230)
			row.AutoButtonColor = false
			Instance.new("UICorner", row).CornerRadius = UDim.new(0, 4)
			rows[plr.UserId] = row

			row.MouseButton1Click:Connect(function()
				selected[plr.UserId] = not selected[plr.UserId]
				row.BackgroundColor3 = selected[plr.UserId] and Color3.fromRGB(18, 48, 34) or Color3.fromRGB(28, 28, 36)
				row.TextColor3 = selected[plr.UserId] and Color3.fromRGB(46, 213, 115) or Color3.fromRGB(220, 220, 230)
			end)
		end
	end
end

refreshList()
Players.PlayerAdded:Connect(refreshList)
Players.PlayerRemoving:Connect(function(plr)
	selected[plr.UserId] = nil
	refreshList()
end)

allBtn.MouseButton1Click:Connect(function()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then selected[plr.UserId] = true end
	end
	refreshList()
end)

clrBtn.MouseButton1Click:Connect(function()
	table.clear(selected)
	refreshList()
end)

local function onToggle()
	state = not state
	toggle.Text = state and "ON" or "OFF"
	toggle.BackgroundColor3 = state and Color3.fromRGB(18, 48, 34) or Color3.fromRGB(26, 26, 33)
	toggle.TextColor3 = state and Color3.fromRGB(46, 213, 115) or Color3.fromRGB(165, 165, 180)
	tStroke.Color = state and Color3.fromRGB(46, 213, 115) or Color3.fromRGB(130, 26, 34)
	led.BackgroundColor3 = state and Color3.fromRGB(46, 213, 115) or Color3.fromRGB(228, 42, 54)
end

toggle.MouseButton1Click:Connect(onToggle)
keyBtn.MouseButton1Click:Connect(onToggle)
UIS.InputBegan:Connect(function(i, gp)
	if not gp and i.KeyCode == Enum.KeyCode.L then onToggle() end
end)
