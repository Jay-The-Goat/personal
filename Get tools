-- Smart Hub Tool Grabber V13 - Infinite Quantum Velocity Edition
-- Fully Unbound Execution: Zero Task Scheduling, Direct Microsecond Memory Lookups

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Tycoons = workspace:WaitForChild("Tycoons", 10)

if not Tycoons then
	warn("[Smart Hub Tool Grabber] workspace.Tycoons nao encontrado.")
	return
end

---------------------------------------------------
-- CONFIG - OVERDRIVE PERFORMANCE CONFIG
---------------------------------------------------

local TOUCH_BURST = 150          -- Drastically increased to force total remote queue saturation
local SPAWN_TOUCH_BURST = 300    -- Massive burst to immediately pull all weapons on frame 1
local PAD_RANGE = 50000          -- Map-wide reach

local QUICK_RECHECK_DELAY = 0    -- ABSOLUTE ZERO DELAY
local SPAWN_FORCE_TIME = 2.0
local SPAWN_FORCE_ALL_TIME = 1.0
local INSTANT_RESPAWN_WINDOW = 3.0

local ALLOWED_BASE_ORDER = {
	"Stone", "Magic", "Storm", "Robotic", "Mecha", "Shadow",
	"Hyper", "Thunder", "Void", "Frozen", "Magma", "Nuclear", "Toxic", "Kong",
}

-- Extreme Speed Pre-compilation: Zero string allocation at runtime
local FAST_BASE_LOOKUP = {}
for i = 1, #ALLOWED_BASE_ORDER do
	local v = ALLOWED_BASE_ORDER[i]
	FAST_BASE_LOOKUP[v:lower()] = v
end

local TOOL_RULES = {
	{ Pattern = "energy sword", Base = "Stone" },
	{ Pattern = "staff", Base = "Magic" },
	{ Pattern = "axe", Base = "Storm" },
	{ Pattern = "fists", Base = "Robotic", ForceBase = true },
	{ Pattern = "frozen claws", Base = "Frozen" },
	{ Pattern = "nuclear claws", Base = "Nuclear" },
	{ Pattern = "hyper claws", Base = "Hyper" },
	{ Pattern = "thunder claws", Base = "Thunder" },
	{ Pattern = "toxic claws", Base = "Toxic" },
	{ Pattern = "shadow claws", Base = "Shadow" },
	{ Pattern = "void claws", Base = "Void" },
	{ Pattern = "magma claws", Base = "Magma" },
	{ Pattern = "punch", Base = "Kong" },
	{ Pattern = "blade arms", Base = "Mecha" },
}

local FORCED_BASE_TOUCHES = { Robotic = 4 }

---------------------------------------------------
-- CLEANUP SYSTEM
---------------------------------------------------

if _G.__SmartHubToolGrabberCleanup then
	pcall(_G.__SmartHubToolGrabberCleanup)
end

local alive = true
local connections = {}
local characterConnections = {}

local function disconnectList(list)
	for i = 1, #list do
		local conn = list[i]
		if conn and conn.Connected then
			conn:Disconnect()
		end
	end
	table.clear(list)
end

local function track(conn)
	table.insert(connections, conn)
	return conn
end

local function trackCharacter(conn)
	table.insert(characterConnections, conn)
	return conn
end

local function cleanup()
	alive = false
	disconnectList(connections)
	disconnectList(characterConnections)
	if _G.SmartHubToolGrabber then
		_G.SmartHubToolGrabber = nil
	end
end

_G.__SmartHubToolGrabberCleanup = cleanup

---------------------------------------------------
-- STATE ENVIRONMENT
---------------------------------------------------

local padsByBase = {}
local registeredPads = {}
local currentCharacter = nil
local currentRoot = nil
local warnedMissingTouch = false

local acquireRunning = false
local scheduleSerial = 0
local lifeSerial = 0
local forceAllUntil = 0
local baseForceUntil = {}
local baseTouchCounts = {}

for i = 1, #ALLOWED_BASE_ORDER do
	padsByBase[ALLOWED_BASE_ORDER[i]] = {}
end

---------------------------------------------------
-- MAX SPEED DISCOVERY ENGINE
---------------------------------------------------

local function normalizeName(value)
	return tostring(value or ""):lower():gsub("[^%w]", "")
end

local function allowedBaseFromName(name)
	local normalized = normalizeName(name)
	local originalName = FAST_BASE_LOOKUP[normalized]
	if originalName then return originalName end
	
	for baseLower, origName in pairs(FAST_BASE_LOOKUP) do
		if normalized:find(baseLower, 1, true) then
			return origName
		end
	end
	return nil
end

local function findGearGiver1Ancestor(instance)
	local node = instance
	while node and node ~= Tycoons do
		if node.Name == "GearGiver1" then
			return node
		end
		node = node.Parent
	end
	return nil
end

local function findAllowedBaseAncestor(instance)
	local node = instance
	while node and node ~= Tycoons do
		local baseName = allowedBaseFromName(node.Name)
		if baseName then
			return baseName, node
		end
		node = node.Parent
	end
	return nil, nil
end

local function registerPad(part)
	if not alive or not part:IsA("BasePart") then return end
	if not part:FindFirstChildOfClass("TouchTransmitter") then return end

	local giver = findGearGiver1Ancestor(part)
	if not giver then return end

	local baseName = findAllowedBaseAncestor(giver.Parent)
	if not baseName then return end

	if registeredPads[part] == baseName then return end

	local oldBase = registeredPads[part]
	if oldBase then
		local oldPads = padsByBase[oldBase]
		if oldPads then
			for i = #oldPads, 1, -1 do
				if oldPads[i] == part then
					table.remove(oldPads, i)
				end
			end
		end
	end

	registeredPads[part] = baseName
	table.insert(padsByBase[baseName], part)
end

local function scanTycoons()
	local descendants = Tycoons:GetDescendants()
	for i = 1, #descendants do
		registerPad(descendants[i])
	end
end
scanTycoons()

track(Tycoons.DescendantAdded:Connect(function(obj)
	task.defer(registerPad, obj)
end))

---------------------------------------------------
-- HIGH-SPEED QUANTUM INVENTORY TRACKING
---------------------------------------------------

local function hasTool(pattern)
	-- Immediate local cache references
	local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
	if backpack then
		local children = backpack:GetChildren()
		for i = 1, #children do
			if string.find(string.lower(children[i].Name), pattern, 1, true) then
				return true
			end
		end
	end
	local character = currentCharacter
	if character then
		local children = character:GetChildren()
		for i = 1, #children do
			if string.find(string.lower(children[i].Name), pattern, 1, true) then
				return true
			end
		end
	end
	return false
end

---------------------------------------------------
-- TARGET ACQUISITION
---------------------------------------------------

local ROOT_PRIORITY = { "HumanoidRootPart", "UpperTorso", "Torso", "LowerTorso", "Head" }

local function getRoot()
	if currentRoot and currentRoot.Parent then
		return currentRoot
	end
	local character = currentCharacter or LocalPlayer.Character
	if not character then return nil end
	
	for i = 1, #ROOT_PRIORITY do
		local part = character:FindFirstChild(ROOT_PRIORITY[i])
		if part and part:IsA("BasePart") then
			currentRoot = part
			return part
		end
	end
	return nil
end

local function getClosestPad(baseName)
	local root = getRoot()
	if not root then return nil end
	local pads = padsByBase[baseName]
	if not pads or #pads == 0 then return nil end
	
	local closest = nil
	local bestDistance = PAD_RANGE
	local rootPos = root.Position
	
	for i = 1, #pads do
		local pad = pads[i]
		if pad and pad.Parent then
			local distance = (pad.Position - rootPos).Magnitude
			if distance < bestDistance then
				bestDistance = distance
				closest = pad
			end
		end
	end
	return closest
end

---------------------------------------------------
-- HARD UNBOUND TOUCH MECHANISM
---------------------------------------------------

local function tapPadInstant(root, pad, burstCount)
	if type(firetouchinterest) ~= "function" then return end
	
	-- Completely unbound raw structural loop for maximum network saturation 
	for i = 1, burstCount do
		firetouchinterest(root, pad, 0)
		firetouchinterest(root, pad, 1)
	end
end

local function processQuantumSequence(currentSerial)
	local root = getRoot()
	if not root then return end

	local now = os.clock()
	local forceAll = (now < forceAllUntil)
	local isSpawning = (now - forceAllUntil < INSTANT_RESPAWN_WINDOW)
	local burst = isSpawning and SPAWN_TOUCH_BURST or TOUCH_BURST

	for i = 1, #TOOL_RULES do
		if not alive or currentSerial ~= scheduleSerial then return end
		local rule = TOOL_RULES[i]
		local baseName = rule.Base
		
		local forced = rule.ForceBase or forceAll or (baseForceUntil[baseName] and now < baseForceUntil[baseName])

		if forced or not hasTool(rule.Pattern) then
			local pad = getClosestPad(baseName)
			if pad then
				tapPadInstant(root, pad, burst)
				
				if FORCED_BASE_TOUCHES[baseName] then
					baseTouchCounts[baseName] = (baseTouchCounts[baseName] or 0) + 1
					if baseTouchCounts[baseName] >= FORCED_BASE_TOUCHES[baseName] then
						baseForceUntil[baseName] = 0
					end
				end
			end
		end
	end
end

local function triggerAcquire()
	if acquireRunning then return end
	acquireRunning = true
	scheduleSerial = scheduleSerial + 1
	local currentSerial = scheduleSerial

	-- Uses Heartbeat loop framework to execute instantly before physics calculations update
	task.spawn(function()
		while alive and currentSerial == scheduleSerial do
			processQuantumSequence(currentSerial)
			if QUICK_RECHECK_DELAY > 0 then
				task.wait(QUICK_RECHECK_DELAY)
			else
				RunService.Heartbeat:Wait()
			end
		end
		acquireRunning = false
	end)
end

---------------------------------------------------
-- LIFE FRAMEWORK PIPELINE
---------------------------------------------------

local function onCharacterReady(character)
	if not character then return end
	currentCharacter = character
	currentRoot = nil
	lifeSerial = lifeSerial + 1

	disconnectList(characterConnections)

	local humanoid = character:WaitForChild("Humanoid", 5)
	if humanoid then
		trackCharacter(humanoid.Died:Connect(function()
			forceAllUntil = 0
			table.clear(baseForceUntil)
			table.clear(baseTouchCounts)
		end))
	end

	forceAllUntil = os.clock() + SPAWN_FORCE_ALL_TIME
	for i = 1, #ALLOWED_BASE_ORDER do
		baseForceUntil[ALLOWED_BASE_ORDER[i]] = os.clock() + SPAWN_FORCE_TIME
	end
	table.clear(baseTouchCounts)

	-- Absolute direct first frame call
	triggerAcquire()
end

if LocalPlayer.Character then
task.spawn(onCharacterReady, LocalPlayer.Character)
end
track(LocalPlayer.CharacterAdded:Connect(function(character)
task.spawn(onCharacterReady, character)
end))
-- Direct hook to step processing cycle
track(RunService.Stepped:Connect(function()
if alive then
triggerAcquire()
end
end))
_G.SmartHubToolGrabber = { Cleanup = cleanup }
