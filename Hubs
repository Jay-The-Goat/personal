local function applyTheme()
mainFrame.BackgroundColor3 = THEME.BgDark
mainFrame.BackgroundTransparency = THEME.BgOpacity
reopenBtn.BackgroundColor3 = THEME.BgDark
mascotImage.Visible = THEME.ShowMascot
mainCorner.CornerRadius = UDim.new(0, THEME.CornerRad)
fxCorner.CornerRadius = UDim.new(0, THEME.CornerRad)
topCorner.CornerRadius = UDim.new(0, THEME.CornerRad)
outerStroke.Thickness = THEME.BorderThick
outerGrad.Color = ColorSequence.new({
ColorSequenceKeypoint.new(0, THEME.Primary),
ColorSequenceKeypoint.new(0.5, THEME.Secondary),
ColorSequenceKeypoint.new(1, THEME.Primary)
})
auraGrad.Color = ColorSequence.new({
ColorSequenceKeypoint.new(0, THEME.Primary),
ColorSequenceKeypoint.new(0.5, THEME.BgDark),
ColorSequenceKeypoint.new(1, THEME.Secondary)
})
topLineGrad.Color = ColorSequence.new({
ColorSequenceKeypoint.new(0, THEME.Primary),
ColorSequenceKeypoint.new(1, THEME.Secondary)
})
local pHex = hexFromColor(THEME.Primary)
local sHex = hexFromColor(THEME.Secondary)
titleLabel.Text = string.format('NEXUS HUB // ANIME OS', pHex, sHex)
reopenBtn.Text = string.format('NEXUS HUB', pHex, sHex)
if THEME.SidebarRight then
sidebar.Position = UDim2.new(1, -62, 0, 36)
contentArea.Position = UDim2.new(0, 6, 0, 36)
mascotImage.Position = UDim2.new(0, -35, 1, -138)
else
sidebar.Position = UDim2.new(0, 6, 0, 36)
contentArea.Position = UDim2.new(0, 68, 0, 36)
mascotImage.Position = UDim2.new(1, -80, 1, -138)
end
for _, f in ipairs(REG.PanelFrames) do f.BackgroundColor3 = THEME.PanelBg end
for _, f in ipairs(REG.RowFrames) do f.BackgroundColor3 = THEME.RowBg end
for _, s in ipairs(REG.PrimaryStrokes) do s.Color = THEME.Primary end
for _, s in ipairs(REG.SecondaryStrokes) do s.Color = THEME.Secondary end
for _, t in ipairs(REG.PrimaryTexts) do t.TextColor3 = THEME.Primary end
for _, t in ipairs(REG.SecondaryTexts) do t.TextColor3 = THEME.Secondary end
for _, lbl in ipairs(REG.AllLabels) do lbl.Font = THEME.CurrentFont end
for _, hdr in ipairs(REG.AllHeaders) do hdr.Font = THEME.HeaderFont end
for _, pt in ipairs(REG.Particles) do
pt.obj.Visible = THEME.ShowSparks and (pt.idx <= THEME.SparkCount)
pt.obj.BackgroundColor3 = pt.isPri and THEME.Primary or THEME.Secondary
end
for name, tb in pairs(REG.TabButtons) do
local active = (name == REG.ActiveTabName)
tb.pill.Visible = active
tb.pill.BackgroundColor3 = THEME.Secondary
tb.btn.BackgroundColor3 = active and THEME.RowBg or THEME.PanelBg
tb.stroke.Color = active and THEME.Secondary or THEME.Primary
tb.icon.TextColor3 = active and THEME.Secondary or THEME.Primary
tb.headerTitle.Font = THEME.HeaderFont
tb.headerTitle.Text = string.format('%s  [%s]', string.upper(name), pHex, tb.sub)
end
for _, tg in ipairs(REG.Toggles) do
local st = tg.getState()
tg.circle.BackgroundColor3 = st and THEME.Secondary or THEME.Primary
tg.stroke.Color = st and THEME.Secondary or THEME.Primary
tg.rowStroke.Color = st and THEME.Secondary or THEME.Primary
tg.pill.BackgroundColor3 = st and THEME.BgDark or THEME.PanelBg
end
for _, sl in ipairs(REG.Sliders) do
sl.fill.BackgroundColor3 = THEME.Secondary
sl.knob.BackgroundColor3 = THEME.Primary
sl.valLbl.TextColor3 = THEME.Secondary
end
end
