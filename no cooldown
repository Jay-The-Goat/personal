local CoreGui = game:GetService("CoreGui")
local UIS = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local parent = (gethui and gethui()) or CoreGui
if parent:FindFirstChild("UI_NoCooldown") then parent.UI_NoCooldown:Destroy() end

local gui = Instance.new("ScreenGui", parent)
gui.Name = "UI_NoCooldown"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true

local scale = Instance.new("UIScale", gui)
local function updateScale()
	local cam = Workspace.CurrentCamera
	if cam then scale.Scale = math.clamp(cam.ViewportSize.Y / 430, 0.68, 1.05) end
end
updateScale()
if Workspace.CurrentCamera then Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale) end

local card = Instance.new("Frame", gui)
card.Size = UDim2.fromOffset(152, 54)
card.Position = UDim2.new(0.5, 6, 0, 48)
card.BackgroundColor3 = Color3.fromRGB(16, 16, 20)
card.BackgroundTransparency = 0.05
Instance.new("UICorner", card).CornerRadius = UDim.new(0, 10)
local stroke = Instance.new("UIStroke", card)
stroke.Color = Color3.fromRGB(228, 42, 54)
stroke.Thickness = 1.4

local title = Instance.new("TextLabel", card)
title.Size = UDim2.new(1, -22, 0, 18)
title.Position = UDim2.fromOffset(8, 4)
title.BackgroundTransparency = 1
title.Text = "⚡ NO COOLDOWN"
title.Font = Enum.Font.GothamBlack
title.TextSize = 9.5
title.TextColor3 = Color3.fromRGB(228, 42, 54)
title.TextXAlignment = Enum.TextXAlignment.Left

local led = Instance.new("Frame", card)
led.Size = UDim2.fromOffset(7, 7)
led.Position = UDim2.new(1, -13, 0, 9)
led.BackgroundColor3 = Color3.fromRGB(228, 42, 54)
Instance.new("UICorner", led).CornerRadius = UDim.new(0, 4)

local state = false
local toggle = Instance.new("TextButton", card)
toggle.Size = UDim2.new(0.62, 0, 0, 22)
toggle.Position = UDim2.fromOffset(8, 25)
toggle.BackgroundColor3 = Color3.fromRGB(26, 26, 33)
toggle.Text = "OFF"
toggle.Font = Enum.Font.GothamBold
toggle.TextSize = 10
toggle.TextColor3 = Color3.fromRGB(165, 165, 180)
toggle.AutoButtonColor = false
Instance.new("UICorner", toggle).CornerRadius = UDim.new(0, 6)
local tStroke = Instance.new("UIStroke", toggle)
tStroke.Color = Color3.fromRGB(130, 26, 34)

local keyBtn = Instance.new("TextButton", card)
keyBtn.Size = UDim2.new(0.25, 0, 0, 22)
keyBtn.Position = UDim2.new(0.69, 0, 0, 25)
keyBtn.BackgroundColor3 = Color3.fromRGB(26, 26, 33)
keyBtn.Text = "[C]"
keyBtn.Font = Enum.Font.GothamBold
keyBtn.TextSize = 9.5
keyBtn.TextColor3 = Color3.fromRGB(245, 245, 250)
Instance.new("UICorner", keyBtn).CornerRadius = UDim.new(0, 6)
Instance.new("UIStroke", keyBtn).Color = Color3.fromRGB(130, 26, 34)

local function onToggle()
	state = not state
	toggle.Text = state and "ON" or "OFF"
	toggle.BackgroundColor3 = state and Color3.fromRGB(18, 48, 34) or Color3.fromRGB(26, 26, 33)
	toggle.TextColor3 = state and Color3.fromRGB(46, 213, 115) or Color3.fromRGB(165, 165, 180)
	tStroke.Color = state and Color3.fromRGB(46, 213, 115) or Color3.fromRGB(130, 26, 34)
	led.BackgroundColor3 = state and Color3.fromRGB(46, 213, 115) or Color3.fromRGB(228, 42, 54)
end

toggle.MouseButton1Click:Connect(onToggle)
keyBtn.MouseButton1Click:Connect(onToggle)
UIS.InputBegan:Connect(function(i, gp)
	if not gp and i.KeyCode == Enum.KeyCode.C then onToggle() end
end)
