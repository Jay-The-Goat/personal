local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")
local parentGui = (gethui and gethui()) or CoreGui

if parentGui:FindFirstChild("UI_GearGrabber") then parentGui.UI_GearGrabber:Destroy() end

local gui = Instance.new("ScreenGui")
gui.Name = "UI_GearGrabber"; gui.IgnoreGuiInset = true; gui.ResetOnSpawn = false; gui.Parent = parentGui

local card = Instance.new("Frame", gui)
card.Size = UDim2.fromOffset(152, 82)
card.Position = UDim2.new(0.02, 0, 0.77, 0)
card.BackgroundColor3 = Color3.fromRGB(16, 16, 20); card.BackgroundTransparency = 0.05
Instance.new("UICorner", card).CornerRadius = UDim.new(0, 9)
local stroke = Instance.new("UIStroke", card); stroke.Color = Color3.fromRGB(228, 42, 54); stroke.Thickness = 1.4

local title = Instance.new("TextLabel", card)
title.Size = UDim2.new(1, -22, 0, 18); title.Position = UDim2.fromOffset(7, 4)
title.BackgroundTransparency = 1; title.Text = "⚡ GEAR GRABBER"
title.Font = Enum.Font.GothamBlack; title.TextSize = 9; title.TextColor3 = Color3.fromRGB(228, 42, 54)
title.TextXAlignment = Enum.TextXAlignment.Left

local led = Instance.new("Frame", card)
led.Size = UDim2.fromOffset(7, 7); led.Position = UDim2.new(1, -14, 0, 9)
led.BackgroundColor3 = Color3.fromRGB(228, 42, 54)
Instance.new("UICorner", led).CornerRadius = UDim.new(0, 4)

local state = false
local btn = Instance.new("TextButton", card)
btn.Size = UDim2.new(0.62, 0, 0, 22); btn.Position = UDim2.fromOffset(7, 26)
btn.BackgroundColor3 = Color3.fromRGB(26, 26, 33); btn.Text = "OFF"
btn.Font = Enum.Font.GothamBold; btn.TextSize = 10; btn.TextColor3 = Color3.fromRGB(165, 165, 180)
btn.AutoButtonColor = false
Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
local bStroke = Instance.new("UIStroke", btn); bStroke.Color = Color3.fromRGB(130, 26, 34); bStroke.Thickness = 1.1

local key = Instance.new("TextButton", card)
key.Size = UDim2.new(0.26, 0, 0, 22); key.Position = UDim2.new(0.69, 0, 0, 26)
key.BackgroundColor3 = Color3.fromRGB(26, 26, 33); key.Text = "[G]"
key.Font = Enum.Font.GothamBold; key.TextSize = 10; key.TextColor3 = Color3.fromRGB(245, 245, 250)
Instance.new("UICorner", key).CornerRadius = UDim.new(0, 6)

local pulseBtn = Instance.new("TextButton", card)
pulseBtn.Size = UDim2.new(1, -14, 0, 22); pulseBtn.Position = UDim2.fromOffset(7, 53)
pulseBtn.BackgroundColor3 = Color3.fromRGB(26, 26, 33); pulseBtn.Text = "PULSE GRAB"
pulseBtn.Font = Enum.Font.GothamBold; pulseBtn.TextSize = 9; pulseBtn.TextColor3 = Color3.fromRGB(245, 245, 250)
Instance.new("UICorner", pulseBtn).CornerRadius = UDim.new(0, 6)

local function toggle()
	state = not state
	btn.Text = state and "ON" or "OFF"
	btn.BackgroundColor3 = state and Color3.fromRGB(18, 48, 34) or Color3.fromRGB(26, 26, 33)
	btn.TextColor3 = state and Color3.fromRGB(46, 213, 115) or Color3.fromRGB(165, 165, 180)
	bStroke.Color = state and Color3.fromRGB(46, 213, 115) or Color3.fromRGB(130, 26, 34)
	led.BackgroundColor3 = state and Color3.fromRGB(46, 213, 115) or Color3.fromRGB(228, 42, 54)
end

btn.MouseButton1Click:Connect(toggle); key.MouseButton1Click:Connect(toggle)
UserInputService.InputBegan:Connect(function(i, gp) if not gp and i.KeyCode == Enum.KeyCode.G then toggle() end end)
