	Transparency = 1 - CONFIG.BoxVisibility * 0.3,
	Size = partSize(),
}, nil)

local boxOutline = new("SelectionBox", {
	Adornee = boxPart,
	Color3 = Color3.fromRGB(220, 40, 45),
	LineThickness = 0.06,
	SurfaceTransparency = 1,
}, boxPart)

boxPart.Parent = Workspace

-- box size can be typed from 0 up to CONFIG.MaxBoxSize
track(sizeBox.FocusLost:Connect(function()
	local n = tonumber(sizeBox.Text)
	if n and n >= 0 then
		CONFIG.BoxSize = math.clamp(n, 0, CONFIG.MaxBoxSize)
	end
	sizeBox.Text = tostring(CONFIG.BoxSize)
end))

local function getRoot(char)
	return char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
end

local function isAlive(char)
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	return hum ~= nil and hum.Health > 0
end

-- the box follows you every frame, and comes back by itself after you respawn
track(RunService.Heartbeat:Connect(function()
	local root = getRoot(player.Character)
	if enabled and root and CONFIG.BoxVisibility > 0 and isAlive(player.Character) then
		boxPart.Size = partSize()
		boxPart.CFrame = CFrame.new(root.Position)
		if boxPart.Parent ~= Workspace then
			boxPart.Parent = Workspace
		end
		boxPart.Transparency = 1 - CONFIG.BoxVisibility * 0.3
		boxOutline.Transparency = 1 - CONFIG.BoxVisibility
		boxOutline.Visible = true
	else
		-- park it far away so it is not seen while dead / hidden
		boxPart.CFrame = CFrame.new(0, -5000, 0)
		boxOutline.Visible = false
	end
end))

------------------------------------------------------------------
-- Kill aura logic
------------------------------------------------------------------
local function insideBox(rootPos, otherPos)
	local half = CONFIG.BoxSize / 2
	local d = otherPos - rootPos
	return math.abs(d.X) <= half and math.abs(d.Y) <= half and math.abs(d.Z) <= half
end

-- every player inside the box (except you and the protected ones)
local function getTargets(root)
	local list = {}
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player and other.Character and isAlive(other.Character) then
			local otherRoot = getRoot(other.Character)
			if not protected[other.Name] and otherRoot and insideBox(root.Position, otherRoot.Position) then
				table.insert(list, other.Character)
			end
		end
	end
	return list
end

local function findTool(char, name)
	local tool = char:FindFirstChild(name)
	if tool and tool:IsA("Tool") then
		return tool
	end
	local backpack = player:FindFirstChildOfClass("Backpack")
	tool = backpack and backpack:FindFirstChild(name)
	if tool and tool:IsA("Tool") then
		return tool
	end
	return nil
end

-- Hits EVERYONE in the box with one tool in the same frame.
-- The tool is activated ONCE (activating it again for every player runs into the
-- tool's own cooldown, so only the first player got hit), then the touch is fired
-- on every target right after, so all of them are hit together.
local function swingAll(tool, targets)
	pcall(function()
		tool:Activate()
	end)

	-- for tools that deal damage by touching: use every part of the tool, not only "Handle"
	if firetouchinterest then
		local toolParts = {}
		for _, d in ipairs(tool:GetDescendants()) do
			if d:IsA("BasePart") then
				table.insert(toolParts, d)
			end
		end
		for _, targetChar in ipairs(targets) do
			local bodyParts = {
				getRoot(targetChar),
				targetChar:FindFirstChild("Head"),
			}
			for _, toolPart in ipairs(toolParts) do
				for _, bodyPart in pairs(bodyParts) do
					pcall(function()
						firetouchinterest(toolPart, bodyPart, 0)
						firetouchinterest(toolPart, bodyPart, 1)
					end)
				end
			end
		end
	end
end

-- Equips every tool in the list and keeps them all in your hand. No waiting in here.
-- hum:EquipTool is the real equip the server sees, but it kicks out the tool you are
-- holding. So: EquipTool the first tool that is not in your hand, then put the rest
-- back into the character by parenting them, so none of them swap out.
local function equipTools(char, hum, toolList)
	local first
	for _, tool in ipairs(toolList) do
		if tool.Parent ~= char then
			first = tool
			break
		end
	end
	if not first then
		return
	end

	pcall(function()
		hum:EquipTool(first)
	end)

	for _, tool in ipairs(toolList) do
		if tool.Parent ~= char then
			pcall(function()
				tool.Parent = char
			end)
		end
	end
end

-- builds the list of tools to use right now
local function buildToolList(char)
	local toolList = {}
	if CONFIG.EquipAll then
		-- put every tool from your backpack in your hand at once, then use them all
		local backpack = player:FindFirstChildOfClass("Backpack")
		if backpack then
			for _, item in ipairs(backpack:GetChildren()) do
				if item:IsA("Tool") then
					pcall(function()
						item.Parent = char
					end)
				end
			end
		end
		for _, item in ipairs(char:GetChildren()) do
			if item:IsA("Tool") then
				table.insert(toolList, item)
			end
		end
	elseif selectedCount() > 0 then
		for name in pairs(selected) do
			local tool = findTool(char, name)
			if tool then
				table.insert(toolList, tool)
			end
		end
	else
		local held = char:FindFirstChildOfClass("Tool")
		if held then
			table.insert(toolList, held)
		end
	end
	return toolList
end

task.spawn(function()
	while running do
		if enabled then
			local char = player.Character
			local root = getRoot(char)
			local hum = char and char:FindFirstChildOfClass("Humanoid")

			if char and root and hum and hum.Health > 0 then
				local targets = getTargets(root)
				statusLabel.Text = "in box: " .. #targets

				-- tools are only equipped and used while someone is inside the box
				if #targets > 0 then
					local toolList = buildToolList(char)
					statusLabel.Text = "in box: " .. #targets .. "  |  tools: " .. #toolList

					-- step 1: equip the picked tools, no delay
					equipTools(char, hum, toolList)

					-- step 2: every tool hits every player in the box right away, no delay
					for _, tool in ipairs(toolList) do
						swingAll(tool, targets)
					end
				end
			end
		end

		-- Speed 100 = no delay at all (just one frame so the game does not freeze).
		-- Lower speed = longer wait between hits (Speed 0 waits SLOWEST_DELAY seconds).
		if not enabled then
			statusLabel.Text = "aura off"
		elseif not (player.Character and getRoot(player.Character)) then
			statusLabel.Text = "waiting for your character"
		end
		local delay = getDelay()
		if delay > 0 then
			waitDelay(delay)
		else
			RunService.Heartbeat:Wait()
		end
	end
end)

------------------------------------------------------------------
-- Cleanup for re-execution
------------------------------------------------------------------
env.__AzanKillAuraCleanup = function()
	running = false
	enabled = false
	for _, c in ipairs(connections) do
		pcall(function()
			c:Disconnect()
		end)
	end
	table.clear(connections)
	pcall(function()
		boxPart:Destroy()
	end)
	if gui then
		gui:Destroy()
	end
end

