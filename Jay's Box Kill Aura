-- Tool dropdown
------------------------------------------------------------------
local function collectToolNames()
	local names, seen = {}, {}
	local function scan(container)
		if not container then
			return
		end
		for _, item in ipairs(container:GetChildren()) do
			if item:IsA("Tool") and not seen[item.Name] then
				seen[item.Name] = true
				table.insert(names, item.Name)
			end
		end
	end
	scan(player:FindFirstChildOfClass("Backpack"))
	scan(player.Character)
	-- keep picked names in the list even if the tool is gone for a moment (after dying)
	for name in pairs(selected) do
		if not seen[name] then
			seen[name] = true
			table.insert(names, name)
		end
	end
	table.sort(names)
	return names
end

local function rebuildDropList()
	for _, child in ipairs(dropList:GetChildren()) do
		if child:IsA("TextButton") or child:IsA("TextLabel") then
			child:Destroy()
		end
	end

	local names = collectToolNames()
	if #names == 0 then
		new("TextLabel", {
			Size = UDim2.new(1, 0, 0, 26),
			BackgroundTransparency = 1,
			Text = "no tools found",
			TextColor3 = THEME.SubText,
			Font = Enum.Font.Gotham,
			TextSize = 12,
			ZIndex = 11,
		}, dropList)
		return
	end

	for i, name in ipairs(names) do
		local row = new("TextButton", {
			Size = UDim2.new(1, -6, 0, 26),
			BackgroundColor3 = selected[name] and THEME.Edge or THEME.Button,
			BorderSizePixel = 0,
			Text = (selected[name] and "[x]  " or "[  ]  ") .. name,
			TextColor3 = THEME.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
			Font = Enum.Font.Gotham,
			TextSize = 12,
			LayoutOrder = i,
			ZIndex = 11,
		}, dropList)
		corner(row)
		new("UIPadding", { PaddingLeft = UDim.new(0, 6) }, row)

		row.MouseButton1Click:Connect(function()
			if selected[name] then
				selected[name] = nil
			else
				selected[name] = true
			end
			row.BackgroundColor3 = selected[name] and THEME.Edge or THEME.Button
			row.Text = (selected[name] and "[x]  " or "[  ]  ") .. name
			refreshTexts()
		end)
	end
end

track(dropBtn.MouseButton1Click:Connect(function()
	protectList.Visible = false
	dropList.Visible = not dropList.Visible
	if dropList.Visible then
		rebuildDropList()
	end
	refreshTexts()
end))

------------------------------------------------------------------
-- Protect list (whitelist)
------------------------------------------------------------------
local function rebuildProtectList()
	for _, child in ipairs(protectList:GetChildren()) do
		if child:IsA("TextButton") or child:IsA("TextLabel") then
			child:Destroy()
		end
	end

	local entries, seen = {}, {}
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			seen[other.Name] = true
			local label = other.Name
			if other.DisplayName ~= other.Name then
				label = other.DisplayName .. " (@" .. other.Name .. ")"
			end
			table.insert(entries, { name = other.Name, label = label })
		end
	end
	-- protected players who left stay in the list so they are still safe if they come back
	for name in pairs(protected) do
		if not seen[name] then
			table.insert(entries, { name = name, label = name .. " (left)" })
		end
	end
	table.sort(entries, function(a, b)
		return a.name:lower() < b.name:lower()
	end)

	if #entries == 0 then
		new("TextLabel", {
			Size = UDim2.new(1, 0, 0, 26),
			BackgroundTransparency = 1,
			Text = "no other players",
			TextColor3 = THEME.SubText,
			Font = Enum.Font.Gotham,
			TextSize = 12,
			ZIndex = 11,
		}, protectList)
		return
	end

	for i, entry in ipairs(entries) do
		local row = new("TextButton", {
			Size = UDim2.new(1, -6, 0, 26),
			BackgroundColor3 = protected[entry.name] and THEME.Edge or THEME.Button,
			BorderSizePixel = 0,
			Text = (protected[entry.name] and "[x]  " or "[  ]  ") .. entry.label,
			TextColor3 = THEME.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Font = Enum.Font.Gotham,
			TextSize = 12,
			LayoutOrder = i,
			ZIndex = 11,
		}, protectList)
		corner(row)
		new("UIPadding", { PaddingLeft = UDim.new(0, 6) }, row)

		row.MouseButton1Click:Connect(function()
			if protected[entry.name] then
				protected[entry.name] = nil
			else
				protected[entry.name] = true
			end
			row.BackgroundColor3 = protected[entry.name] and THEME.Edge or THEME.Button
			row.Text = (protected[entry.name] and "[x]  " or "[  ]  ") .. entry.label
			refreshTexts()
		end)
	end
end

track(protectBtn.MouseButton1Click:Connect(function()
	dropList.Visible = false
	protectList.Visible = not protectList.Visible
	if protectList.Visible then
		rebuildProtectList()
	end
	refreshTexts()
end))

