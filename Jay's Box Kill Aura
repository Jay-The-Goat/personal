local function WaitSeconds(duration)
	local start = os.clock()
	repeat
		RunService.Heartbeat:Wait()
	until os.clock() - start >= duration
end

local function GetLoopDelay()
	local ratio = (Config.MaxSpeed - Config.Speed) / Config.MaxSpeed
	return math.max(ratio, 0) * BaseDelay
end

