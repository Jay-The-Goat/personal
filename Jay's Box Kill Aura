local function selectedCount()
	local n = 0
	for _ in pairs(selected) do
		n += 1
	end
	return n
end

local function refreshTexts()
	toggleBtn.Text = "Kill Aura: " .. (enabled and "ON" or "OFF")
	-- red when off, green when on
	local color = enabled and THEME.On or THEME.Off
	toggleBtn.BackgroundColor3 = color
	openBtn.TextColor3 = color
	openStroke.Color = color

	local n = selectedCount()
	local label = CONFIG.EquipAll and "all tools" or (n == 0 and "none selected" or (n .. " selected"))
	dropBtn.Text = "Tools: " .. label .. (dropList.Visible and "  ^" or "  v")
	local protectedN = 0
	for _ in pairs(protected) do
		protectedN += 1
	end
	protectBtn.Text = "Protect: " .. (protectedN == 0 and "none" or (protectedN .. " safe")) .. (protectList.Visible and "  ^" or "  v")
	speedValue.Text = tostring(CONFIG.Speed)
	equipBtn.Text = "Equip all tools: " .. (CONFIG.EquipAll and "ON" or "OFF")
	sliderLabel.Text = "Box visibility: " .. math.floor(CONFIG.BoxVisibility * 100 + 0.5) .. "%"
end

local function setEnabled(value)
	enabled = value
	refreshTexts()
end

track(toggleBtn.MouseButton1Click:Connect(function()
	setEnabled(not enabled)
end))

track(equipBtn.MouseButton1Click:Connect(function()
	CONFIG.EquipAll = not CONFIG.EquipAll
	refreshTexts()
end))

-- speed - / + buttons: tap = 10 steps, hold to keep going (0 to 100, 100 = fastest)
local holding = false
local holdToken = 0

local function changeSpeed(delta)
	CONFIG.Speed = math.clamp(CONFIG.Speed + delta, 0, CONFIG.MaxSpeed)
	refreshTexts()
end

local function hookStep(button, delta)
	track(button.InputBegan:Connect(function(input)
		if isPress(input) then
			holding = true
			holdToken += 1
			local myToken = holdToken
			changeSpeed(delta)
			task.spawn(function()
				waitDelay(0.4)
				while holding and holdToken == myToken and running do
					changeSpeed(delta)
					waitDelay(0.06)
				end
			end)
		end
	end))
end

hookStep(minusBtn, -10)
hookStep(plusBtn, 10)

track(UserInputService.InputEnded:Connect(function(input)
	if isPress(input) then
		holding = false
	end
end))

-- slider: drag with mouse or finger
local sliding = false

local function setVisibilityFromX(x)
	local ratio = math.clamp((x - sliderTrack.AbsolutePosition.X) / sliderTrack.AbsoluteSize.X, 0, 1)
	CONFIG.BoxVisibility = ratio
	sliderFill.Size = UDim2.fromScale(ratio, 1)
	sliderKnob.Position = UDim2.new(ratio, 0, 0.5, 0)
	refreshTexts()
end

track(sliderTrack.InputBegan:Connect(function(input)
	if isPress(input) then
		sliding = true
		setVisibilityFromX(input.Position.X)
	end
end))

track(UserInputService.InputChanged:Connect(function(input)
	if sliding and isMove(input) then
		setVisibilityFromX(input.Position.X)
	end
end))

track(UserInputService.InputEnded:Connect(function(input)
	if sliding and isPress(input) then
		sliding = false
	end
end))

track(UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == CONFIG.ToggleKey then
		setEnabled(not enabled)
	end
end))

