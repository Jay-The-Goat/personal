-- Combat / Aura Helpers
local function GetRoot(char)
return char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
end
local function IsAlive(char)
local hum = char and char:FindFirstChildOfClass("Humanoid")
return hum ~= nil and hum.Health > 0
end
TrackConnection(RunService.Heartbeat:Connect(function()
local root = GetRoot(LocalPlayer.Character)
if Enabled and root and Config.BoxVisibility > 0 and IsAlive(LocalPlayer.Character) then
AuraBox.Size = GetBoxVector()
AuraBox.CFrame = CFrame.new(root.Position)
if AuraBox.Parent ~= Workspace then AuraBox.Parent = Workspace end
AuraBox.Transparency = 1 - Config.BoxVisibility * 0.3
SelectionBox.Transparency = 1 - Config.BoxVisibility
SelectionBox.Visible = true
else
AuraBox.CFrame = CFrame.new(0, -5000, 0)
SelectionBox.Visible = false
end
end))
local function IsInBox(origin, targetPos)
local half = Config.BoxSize / 2
local diff = targetPos - origin
return math.abs(diff.X) <= half and math.abs(diff.Y) <= half and math.abs(diff.Z) <= half
end
local function GetTargetsInRange(root)
local targets = {}
for _, plr in ipairs(Players:GetPlayers()) do
if plr ~= LocalPlayer and plr.Character and IsAlive(plr.Character) then
local targetRoot = GetRoot(plr.Character)
if not ProtectedPlayers[plr.Name] and targetRoot and IsInBox(root.Position, targetRoot.Position) then
table.insert(targets, plr.Character)
end
end
end
return targets
end
local function FindTool(char, name)
local tool = char:FindFirstChild(name)
if tool and tool:IsA("Tool") then return tool end
local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
tool = backpack and backpack:FindFirstChild(name)
if tool and tool:IsA("Tool") then return tool end
return nil
end
local function AttackWithTool(tool, targets)
pcall(function() tool:Activate() end)
if firetouchinterest then
local handles = {}
for _, desc in ipairs(tool:GetDescendants()) do
if desc:IsA("BasePart") then table.insert(handles, desc) end
end
for _, targetChar in ipairs(targets) do
-- Note: Bug in original script references undefined 'targetChar' instead of loop variable
local hitParts = { getRoot(targetChar), targetChar:FindFirstChild("Head") }
for _, handle in ipairs(handles) do
for _, part in pairs(hitParts) do
pcall(function()
firetouchinterest(handle, part, 0)
firetouchinterest(handle, part, 1)
end)
end
end
end
end
end
local function EquipTools(char, hum, tools)
local firstUnequipped = nil
for _, tool in ipairs(tools) do
if tool.Parent ~= char then
firstUnequipped = tool
break
end
end
if not firstUnequipped then return end
pcall(function() hum:EquipTool(firstUnequipped) end)
for _, tool in ipairs(tools) do
if tool.Parent ~= char then
pcall(function() tool.Parent = char end)
end
end
end
local function GatherToolsToUse(char)
local tools = {}
if Config.EquipAll then
local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
if backpack then
for _, item in ipairs(backpack:GetChildren()) do
if item:IsA("Tool") then pcall(function() item.Parent = char end) end
end
end
for _, item in ipairs(char:GetChildren()) do
if item:IsA("Tool") then table.insert(tools, item) end
end
elseif CountSelectedTools() > 0 then
for name in pairs(SelectedTools) do
local tool = FindTool(char, name)
if tool then table.insert(tools, tool) end
end
else
local equipped = char:FindFirstChildOfClass("Tool")
if equipped then table.insert(tools, equipped) end
end
return tools
end
