local function GetGuiParent()
	if gethui then
		local ok, hui = pcall(gethui)
		if ok and hui then return hui end
	end
	local ok, coreGui = pcall(function() return game:GetService("CoreGui") end)
	if ok and coreGui then return coreGui end
	return LocalPlayer:WaitForChild("PlayerGui")
end

local function Create(className, props, parent)
	local inst = Instance.new(className)
	for k, v in pairs(props) do
		inst[k] = v
	end
	inst.Parent = parent
	return inst
end

local function AddCorner(inst, radius)
	Create("UICorner", { CornerRadius = UDim.new(0, radius or 3) }, inst)
end

local function IsPrimaryInput(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

local function IsMoveInput(input)
	return input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch
end

local function MakeDraggable(handle, target, onClick)
	local dragging, moved = false, false
	local startPos, startInput = nil, nil

	TrackConnection(handle.InputBegan:Connect(function(input)
		if IsPrimaryInput(input) then
			dragging, moved = true, false
			startInput = input.Position
			startPos = target.Position
		end
	end))

	TrackConnection(UserInputService.InputChanged:Connect(function(input)
		if dragging and IsMoveInput(input) then
			local delta = input.Position - startInput
			if delta.Magnitude > 6 then moved = true end
			if moved then
				target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
			end
		end
	end))

	TrackConnection(UserInputService.InputEnded:Connect(function(input)
		if dragging and IsPrimaryInput(input) then
			dragging = false
			if not moved and onClick then onClick() end
		end
	end))
end

