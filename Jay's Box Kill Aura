-- Azan kill aura
-- this script was made by Azan
-- A box shows around you. Anyone who steps inside the box gets hit by the tools you picked.

local CONFIG = {
	BoxSize = 50,                    -- studs, the box is this long on every side
	MaxBoxSize = 250,                -- <<< biggest box size you can set (0 to this number)
	Speed = 100,                     -- 0 to 100. 100 = fastest (no delay at all), 0 = slowest
	MaxSpeed = 100,                  -- top of the speed range (100 = fastest)
	BoxVisibility = 0.7,             -- 0 = box invisible, 1 = box fully visible (the slider changes this)
	EquipAll = false,                -- true = equip every tool at once and hit with all of them
	ToggleKey = Enum.KeyCode.K,      -- <<< CHANGE THE KEYBIND HERE (PC only, turns the aura on/off)
}

-- Seconds of waiting between hits when Speed is 0. The wait shrinks as Speed goes up
-- and is gone completely at Speed 100 (equip + use tools happen every frame, no delay).
local SLOWEST_DELAY = 1

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local env = (getgenv and getgenv()) or _G

-- remove the old copy if you execute this twice
if env.__AzanKillAuraCleanup then
	pcall(env.__AzanKillAuraCleanup)
	env.__AzanKillAuraCleanup = nil
end

local connections = {}
local function track(c)
	table.insert(connections, c)
	return c
end

local enabled = false
local running = true

-- Own wait function. The no cool down script hooks task.wait and makes every wait last
-- one frame, which would ignore the speed setting. Heartbeat:Wait() is not hooked.
local function waitDelay(seconds)
	local start = os.clock()
	repeat
		RunService.Heartbeat:Wait()
	until os.clock() - start >= seconds
end

-- delay between hits from the Speed setting (0 at Speed 100)
local function getDelay()
	local ratio = (CONFIG.MaxSpeed - CONFIG.Speed) / CONFIG.MaxSpeed
	return math.max(ratio, 0) * SLOWEST_DELAY
end

local protected = {} -- player NAMES that the aura will never hit (kept after they respawn)
local selected = {} -- tool NAMES (so it still works after you respawn and the tools are new)

